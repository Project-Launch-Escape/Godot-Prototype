[physics]

common/physics_ticks_per_second=300
3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/max_linear_velocity=5000000000000.0
3d/default_gravity=0.0
3d/default_gravity_vector=Vector3(0, 0, 0)
3d/default_linear_damp=0.0
3d/sleep_threshold_linear=0.0
3d/sleep_threshold_angular=0.0139626

[rendering]

lights_and_shadows/use_physical_light_units=true
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=true
